sketchybar --add bracket app_group front_app
          #  --set app_group "${GROUP_BG[@]}"
sketchybar --add bracket app_group_external front_app_external
          #  --set app_group_external "${GROUP_BG[@]}"

sketchybar --add bracket right_widgets clock volume volume_slider battery slack keyboard cpu
          #  --set right_widgets "${GROUP_BG[@]}"
sketchybar --set right_widgets background.padding_right=18

sketchybar --hotload on
sketchybar --update
