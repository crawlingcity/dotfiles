# Ghostty configuration migrated from wezterm.lua (macOS settings).

# Appearance
font-family = JetBrains Mono
font-family-bold = JetBrains Mono
font-family-italic = JetBrains Mono
font-family-bold-italic = JetBrains Mono
font-style = Bold
font-style-bold = Bold
font-style-italic = Bold Italic
font-style-bold-italic = Bold Italic
font-size = 14
window-decoration = auto
macos-titlebar-style = tabs
macos-window-buttons = hidden
shell-integration-features = ssh-env
copy-on-select = clipboard
selection-word-chars = " \t'\"│`|:;,()[]{}<>$`=?"

# Preserve the existing custom Nord-style palette.
background = #20232c
foreground = #d9dde7
split-divider-color = #4d5568
palette = 0=#3c4150
palette = 1=#b2656b
palette = 2=#a8bd90
palette = 3=#e5cc93
palette = 4=#87a0be
palette = 5=#ae8fab
palette = 6=#93becd
palette = 7=#e5e8ef
palette = 8=#4d5568
palette = 9=#b2656b
palette = 10=#a8bd90
palette = 11=#e5cc93
palette = 12=#87a0be
palette = 13=#ae8fab
palette = 14=#98baba
palette = 15=#eceef3
palette = 93=#aabbff
palette = 129=#aabbff
palette = 135=#aabbff

# Keybindings carried over from WezTerm.
keybind = super+shift+r=reload_config
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# macOS pane controls. `super` is the Command key on macOS.
keybind = super+d=new_split:down
keybind = super+shift+d=new_split:right
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+shift+enter=toggle_split_zoom
keybind = super+k=clear_screen

# Linux pane controls. They avoid Super, which window managers often intercept.
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F
keybind = super+ctrl+arrow_up=text:\x01\x1b[A
keybind = super+ctrl+arrow_down=text:\x01\x1b[B
keybind = super+ctrl+arrow_left=text:\x01\x1b[D
keybind = super+ctrl+arrow_right=text:\x01\x1b[C
